<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      存储权限：
      Android 10 (API 29) 起使用 MediaStore 分区存储，写入相册无需权限，
      因此用 maxSdkVersion=28 限制只在 Android 9 及以下申请。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!--
      检查更新：需要访问 GitHub Releases API。
      仅用于「检查更新」功能，无任何其它网络行为。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      应用内下载安装新版本（实验性功能，默认关闭）。

      注意：这是「特殊权限」，不是运行时权限 —— 无法用 requestPermissions
      申请，必须引导用户到系统设置里手动开启。
      且只有在用户主动打开「应用内下载更新」开关后，应用才会：
        1. 跳转授权页
        2. 用 FileProvider 唤起系统安装器
      默认关闭时，应用完全不触碰此权限，行为与无此权限一致。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".WatermarkBoxApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WatermarkBox"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WatermarkBox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          应用内语言切换（AppCompat per-app language）。

          Android 13+ 由系统直接处理；Android 12 及以下靠这个 Service 让
          AppCompatDelegate.setApplicationLocales() 生效，
          并在系统「应用语言」设置里列出本应用支持的语言。
          locales_config.xml 则声明了支持哪些语言（供系统设置页读取）。
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
          应用内安装更新包时，把私有目录的 APK 以 Content URI 形式
          安全地交给系统安装器（Android 7.0+ 禁止直接传 file://）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>