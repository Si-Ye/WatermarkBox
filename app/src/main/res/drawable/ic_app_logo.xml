<?xml version="1.0" encoding="utf-8"?>
<!--
  水印盒应用图标（矢量版，供首页展示使用）
  由 branding/ic_launcher.svg 转换而来，与启动器图标保持一致。

  画布 1024x1024；内容位于中心安全区（约 ±240）。
  与 SVG 的差异：
  - SVG 的 <g transform> 已展开为绝对坐标
  - 圆角矩形 <rect rx> 展开为带弧线的 path
  - 圆形 <circle> 展开为两段弧线的 path
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!--
      背景：品牌深蓝 + **自带圆角**。

      ## 为什么圆角写在矢量图里，而不是靠外层 clip

      此前背景是直角方形（`M0,0 L1024,0 …`），圆润感来自调用方的
      `Modifier.clip(RoundedCornerShape(…))`。这样有两个问题：
      1. **同一个图标在不同页面圆角不一致** —— 首页 24dp、关于页 20dp，
         看起来像两个不同的图标
      2. 一旦哪处漏了 clip，就会露出尖锐的直角

      圆角画进图里之后，任何地方引用它都是同一个形状，
      调用方也就不必再关心裁切。

      半径取 224/1024 ≈ 21.9%，接近系统「自适应图标」的视觉重量
      （方形蒙版圆角约为边长的 20%）。
    -->
    <path
        android:fillColor="#1A237E"
        android:pathData="M224,0 L800,0
                          A224,224 0 0 1 1024,224 L1024,800
                          A224,224 0 0 1 800,1024 L224,1024
                          A224,224 0 0 1 0,800 L0,224
                          A224,224 0 0 1 224,0 Z" />

    <!-- 盒子盖（顶部横条，圆角 26） -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95"
        android:pathData="M298,296 L726,296 A26,26 0 0 1 752,322 L752,354
                          A26,26 0 0 1 726,380 L298,380
                          A26,26 0 0 1 272,354 L272,322
                          A26,26 0 0 1 298,296 Z" />

    <!-- 盒子主体（白色描边方框，stroke-width 44，四角圆弧半径 48） -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="44"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M292,412 L292,692
                          A48,48 0 0 0 340,740 L684,740
                          A48,48 0 0 0 732,692 L732,412" />

    <!-- 水滴（琥珀色） -->
    <path
        android:fillColor="#FF6F00"
        android:pathData="M512,462
                          C424,540 388,582 388,634
                          C388,702 444,746 512,746
                          C580,746 636,702 636,634
                          C636,582 600,540 512,462 Z" />

    <!-- 水滴高光（白色，半径 28，圆心 (468,638)） -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.42"
        android:pathData="M440,638 A28,28 0 1 1 496,638 A28,28 0 1 1 440,638 Z" />

    <!-- 左侧短横线（圆角 10，半透明） -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M332,526 L370,526 A10,10 0 0 1 380,536 L380,536
                          A10,10 0 0 1 370,546 L332,546
                          A10,10 0 0 1 322,536 L322,536
                          A10,10 0 0 1 332,526 Z" />

    <!-- 右侧短横线 -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M654,526 L692,526 A10,10 0 0 1 702,536 L702,536
                          A10,10 0 0 1 692,546 L654,546
                          A10,10 0 0 1 644,536 L644,536
                          A10,10 0 0 1 654,526 Z" />

</vector>