    <!-- ==================== Release notes: 1.4.1 ==================== -->
    <string name="release_1_4_1_title">Changelog screen</string>
    <string name="release_1_4_1_c1">Added a changelog under Settings → Other, listing every change since 1.0.0</string>
    <string name="release_1_4_1_c2">Grouped Changelog and About together in Settings for a consistent look</string>

    <!-- ==================== Release notes: 1.4.0 ==================== -->
    <string name="release_1_4_0_title">Editable presets · Batch screen rework</string>
    <string name="release_1_4_0_c1">Added a presets entry in the top-right of the home screen for centralised management</string>
    <string name="release_1_4_0_c2">Added a preset editor: rename a preset and tweak every watermark parameter without picking an image first</string>
    <string name="release_1_4_0_c3">Added an edit icon on preset cards; renaming now lives in the editor (one less entry point and one less tap)</string>
    <string name="release_1_4_0_c4">Fixed presets being silently overwritten when saving under an existing name — a data-loss bug. You are now asked whether to keep both, replace, or cancel</string>
    <string name="release_1_4_0_c5">Reworked the batch screen so it matches single-image editing: same parameter panel, draggable sheet, presets and export settings</string>
    <string name="release_1_4_0_c6">Batch preview now supports swiping between images, with an "add more" page at the end</string>
    <string name="release_1_4_0_c7">Fixed batch preview not swiping at all — the preview component was swallowing horizontal gestures; it now yields them on the batch screen</string>
    <string name="release_1_4_0_c8">Added a DCT toggle for hidden watermarks, so frequency-domain embedding can be controlled separately; the effect on image quality is stated explicitly and left to your judgement</string>
    <string name="release_1_4_0_c9">Added a setting to enable DCT by default when turning on a hidden watermark</string>
    <string name="release_1_4_0_c10">Added category tabs at the top of Settings: Watermark / Export / Other</string>
    <string name="release_1_4_0_c11">Added a default watermark text setting, prefilled when you open the editor</string>
    <string name="release_1_4_0_c12">Added a default watermark image setting, loaded automatically when you open the editor</string>
    <string name="release_1_4_0_c13">Added a standalone About screen: app icon, version, credits (avatar and QQ), and open-source license</string>
    <string name="release_1_4_0_c14">Added this changelog screen</string>

    <!-- ==================== Release notes: 1.3.1 ==================== -->
    <string name="release_1_3_1_title">Duplicate-name protection for presets</string>
    <string name="release_1_3_1_c1">Saving a preset under an existing name now asks whether to keep both, replace, or cancel, instead of overwriting silently</string>
    <string name="release_1_3_1_c2">Duplicate names are detected as you type, rather than only when you press save</string>

    <!-- ==================== Release notes: 1.3.0 ==================== -->
    <string name="release_1_3_0_title">Hidden watermark tracing · EXIF preserved</string>
    <string name="release_1_3_0_c1">Added hidden watermarks: tracing data is written into the image through two channels — EXIF metadata and DCT frequency domain</string>
    <string name="release_1_3_0_c2">Added hidden watermark detection to check whether an image carries one written by this app</string>
    <string name="release_1_3_0_c3">The hidden watermark content can be customised, or generated automatically from a device ID and timestamp</string>
    <string name="release_1_3_0_c4">Export can now preserve the original EXIF data (35 fields including capture time, camera model and GPS)</string>
    <string name="release_1_3_0_c5">Fixed hidden watermarks containing Chinese characters being detected as "?" (a character-encoding limitation in the EXIF UserComment field)</string>

    <!-- ==================== Release notes: 1.2.0 ==================== -->
    <string name="release_1_2_0_title">Batch processing · Custom fonts</string>
    <string name="release_1_2_0_c1">Added batch processing: up to 50 images at once, running in the background with a progress indicator</string>
    <string name="release_1_2_0_c2">Added support for importing custom fonts (ttf / otf / ttc) for text watermarks</string>
    <string name="release_1_2_0_c3">Added watermark presets for saving and reapplying common configurations</string>
    <string name="release_1_2_0_c4">Text watermarks now support placeholders such as {filename}</string>

    <!-- ==================== Release notes: 1.1.0 ==================== -->
    <string name="release_1_1_0_title">More parameters · Export settings</string>
    <string name="release_1_1_0_c1">Text watermarks gained size, font, bold, italic, stroke, shadow and colour</string>
    <string name="release_1_1_0_c2">Added single, tiled and diagonal layouts with adjustable rotation and opacity</string>
    <string name="release_1_1_0_c3">Added 3×3 grid positioning with adjustable margins</string>
    <string name="release_1_1_0_c4">Image watermarks: pick a logo and adjust its size and position</string>
    <string name="release_1_1_0_c5">Added export settings: format (PNG / JPEG), quality, filename template and output folder</string>
    <string name="release_1_1_0_c6">The parameter panel can be dragged up and down to resize</string>

    <!-- ==================== Release notes: 1.0.0 ==================== -->
    <string name="release_1_0_0_title">First release</string>
    <string name="release_1_0_0_c1">WatermarkBox is born: add a watermark to a single image with live preview</string>
    <string name="release_1_0_0_c2">Supports text and image watermarks</string>
