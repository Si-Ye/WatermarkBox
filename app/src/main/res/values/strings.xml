    <!-- ==================== 更新日志：1.4.0 ==================== -->
    <string name="release_1_4_0_title">预设可独立编辑 · 批量页大改</string>
    <string name="release_1_4_0_c1">首页右上角新增「水印预设」入口，可集中管理预设</string>
    <string name="release_1_4_0_c2">新增预设参数编辑页：不选图片也能直接改预设的名称与全部水印参数</string>
    <string name="release_1_4_0_c3">预设卡片新增编辑图标，重命名并入编辑页（少一个入口，少一次跳转）</string>
    <string name="release_1_4_0_c4">修复保存同名预设时静默覆盖旧预设的问题（属数据丢失），现在会先询问保留 / 替换 / 取消</string>
    <string name="release_1_4_0_c5">批量处理页整体重做，界面与单张编辑保持一致：同样的参数面板、可拖拽抽屉、同一套预设与导出设置</string>
    <string name="release_1_4_0_c6">批量预览支持左右滑动切换图片，末页为「添加更多」，可继续追加图片</string>
    <string name="release_1_4_0_c7">修复批量预览无法滑动的问题：预览组件的手势会拦截横滑，现已在批量页让出手势</string>
    <string name="release_1_4_0_c8">隐藏水印新增 DCT 频域开关：可单独控制是否写入频域，并明确标注其对画质的影响，由用户按场景自行取舍</string>
    <string name="release_1_4_0_c9">设置中新增「开启隐藏水印时默认启用 DCT」选项</string>
    <string name="release_1_4_0_c10">设置页顶部新增分类菜单：水印 / 导出 / 其他</string>
    <string name="release_1_4_0_c11">新增「默认水印文字」设置：选图进编辑页时自动填入</string>
    <string name="release_1_4_0_c12">新增「默认水印图」设置：选图进编辑页时自动载入该 logo</string>
    <string name="release_1_4_0_c13">新增独立「关于」页：应用图标、版本、制作人（含头像与 QQ）、开源许可</string>
    <string name="release_1_4_0_c14">新增本次「更新说明」页</string>

    <!-- ==================== 更新日志：1.3.1 ==================== -->
    <string name="release_1_3_1_title">预设重名保护</string>
    <string name="release_1_3_1_c1">保存预设遇到重名时，弹出「保留两者 / 替换 / 取消」确认框，替代此前的静默覆盖</string>
    <string name="release_1_3_1_c2">输入预设名称时实时检测重名并提示，不用点保存才知道</string>

    <!-- ==================== 更新日志：1.3.0 ==================== -->
    <string name="release_1_3_0_title">隐藏水印溯源 · EXIF 保留</string>
    <string name="release_1_3_0_c1">新增隐藏水印功能：把溯源信息写入图片，包含 EXIF 元数据与 DCT 频域两条通道</string>
    <string name="release_1_3_0_c2">新增隐藏水印检测：可判断图片是否含本应用写入的隐藏水印</string>
    <string name="release_1_3_0_c3">支持自定义隐藏水印内容，或自动使用「设备 ID + 时间戳」</string>
    <string name="release_1_3_0_c4">导出时可选保留原图 EXIF 信息（拍摄时间、机型、GPS 等 35 项）</string>
    <string name="release_1_3_0_c5">修复隐藏水印使用中文时检测结果变成 ? 的问题（EXIF UserComment 的字符集编码限制）</string>

    <!-- ==================== 更新日志：1.2.0 ==================== -->
    <string name="release_1_2_0_title">批量处理 · 自定义字体</string>
    <string name="release_1_2_0_c1">新增批量处理：一次最多 50 张，后台处理并显示进度</string>
    <string name="release_1_2_0_c2">支持导入自定义字体（ttf / otf / ttc）用于文字水印</string>
    <string name="release_1_2_0_c3">新增水印预设：可保存常用配置并快速套用</string>
    <string name="release_1_2_0_c4">文字水印支持 {filename} 等占位符</string>

    <!-- ==================== 更新日志：1.1.0 ==================== -->
    <string name="release_1_1_0_title">参数完善 · 导出设置</string>
    <string name="release_1_1_0_c1">文字水印支持字号、字体、加粗、斜体、描边、阴影、颜色</string>
    <string name="release_1_1_0_c2">支持单个 / 平铺 / 对角线三种布局，可调旋转与透明度</string>
    <string name="release_1_1_0_c3">支持九宫格定位与边距调整</string>
    <string name="release_1_1_0_c4">图片水印：可选择 logo、调整大小与位置</string>
    <string name="release_1_1_0_c5">新增导出设置：格式（PNG / JPEG）、质量、文件名模板、输出目录</string>
    <string name="release_1_1_0_c6">参数面板支持上下拖拽调整高度</string>

