#!/bin/sh
# ============================================================
# pre-commit 钩子：提交前跑一遍敏感信息审计
# ============================================================
#
# ## 为什么需要它
#
# `.gitignore` 只拦得住「未被 git 跟踪」的文件。一旦某个敏感文件
# 已经被 `git add`（比如手滑 `git add -A` 时），`.gitignore` 就不起作用了。
#
# 而密码一旦进入 git 历史，就算后续删除文件，内容也永久留在历史里 —— 
# 要靠 `git filter-repo` 重写历史才能清掉，代价极大。
#
# 所以加这道**提交前**的闸门：有问题就拦住，不给历史被污染的机会。
#
# ## 安装
#
#     sh tools/install_hooks.sh
#
# （新克隆仓库后需要执行一次；钩子文件本身在 .git/ 里，不随仓库分发）
#
# ## 跳过
#
# 确实需要绕过时（不推荐）：`git commit --no-verify`
#
# ============================================================

# 找到仓库根目录（钩子运行时 cwd 是仓库根，但保险起见还是算一下）
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 0

AUDIT="$ROOT/tools/pre_push_audit.sh"
if [ ! -f "$AUDIT" ]; then
    # 审计脚本不存在就不拦（比如别人的 fork 里删了这个文件）
    exit 0
fi

# ============================================================
# 工作区同步检查（方案 D）
# ============================================================
#
# ## 为什么需要
#
# 本项目有**两套路径**：工作区（AI 工具读写）与 git 仓库（提交/构建）。
# 代码改动要**手动 cp** 同步过去 —— 漏一次就会**提交旧代码**，
# 而 `git commit` 本身不会告诉你这件事（本轮真实踩过，手打 cp 6 次以上）。
#
# ## 配置
#
# 读 `.git/collab-config`（**本机文件，不入库**），内容一行：
#
#     WORKSPACE=<工作区根目录>
#
# 用 sed 提取而非 `source` —— 避免执行文件里的任意代码。
# **没这个文件就跳过**（别的机器/克隆里没有，不该因此阻塞提交）。
#
# ## 判定
#
# 交给 `tools/collab_status.py --check-sync`：
# 它只比「应该一致」的内容，并**自动忽略本机临时文件**
# （`.`/`_` 前缀、`__pycache__` 等）。
#
# ============================================================
CFG="$ROOT/.git/collab-config"
WORKSPACE=""
if [ -f "$CFG" ]; then
    WORKSPACE=$(sed -n 's/^WORKSPACE=//p' "$CFG" | head -1)
fi

if [ -n "$WORKSPACE" ] && [ -d "$WORKSPACE" ] && command -v python3 >/dev/null 2>&1; then
    if ! python3 "$ROOT/tools/collab_status.py" --check-sync --workspace "$WORKSPACE"; then
        echo ""
        echo "=========================================="
        echo " 提交被拦截：工作区改动尚未同步到仓库"
        echo "=========================================="
        echo " 先同步再提交，否则仓库里是旧代码。"
        echo " 同步：cp -r \"$WORKSPACE/app/src/.\" \"$ROOT/app/src/\""
        echo " 确实无需同步（如只改本机文件）：git commit --no-verify"
        echo ""
        exit 1
    fi
fi

echo "[pre-commit] 正在审计暂存区内容..."
if ! sh "$AUDIT" --staged; then
    echo ""
    echo "=========================================="
    echo " 提交被拦截：暂存区里可能有敏感信息"
    echo "=========================================="
    echo " 请检查并移除上述文件后重试。"
    echo " 确实要绕过（不推荐）：git commit --no-verify"
    echo ""
    exit 1
fi

echo "[pre-commit] 审计通过 ✓"
exit 0
