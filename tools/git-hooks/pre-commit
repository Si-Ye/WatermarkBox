#!/bin/sh
# ============================================================
# pre-commit 钩子：提交前跑一遍敏感信息审计
# ============================================================
#
# ## 为什么需要它
#
# `.gitignore` 只拦得住「未被 git 跟踪」的文件。一旦某个敏感文件
# 已经被 `git add`（比如手滑 `git add -A` 时），`.gitignore` 就不起作用了。
#
# 而密码一旦进入 git 历史，就算后续删除文件，内容也永久留在历史里 —— 
# 要靠 `git filter-repo` 重写历史才能清掉，代价极大。
#
# 所以加这道**提交前**的闸门：有问题就拦住，不给历史被污染的机会。
#
# ## 安装
#
#     sh tools/install_hooks.sh
#
# （新克隆仓库后需要执行一次；钩子文件本身在 .git/ 里，不随仓库分发）
#
# ## 跳过
#
# 确实需要绕过时（不推荐）：`git commit --no-verify`
#
# ============================================================

# 找到仓库根目录（钩子运行时 cwd 是仓库根，但保险起见还是算一下）
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 0

AUDIT="$ROOT/tools/pre_push_audit.sh"
if [ ! -f "$AUDIT" ]; then
    # 审计脚本不存在就不拦（比如别人的 fork 里删了这个文件）
    exit 0
fi

# ============================================================
# 工作区同步检查（方案 D）
# ============================================================
#
# ## 为什么需要
#
# 手机端有两套路径：工作区（AI 工具读写）与 git 仓库（提交/构建）。
# 代码改动要**手动 cp** 同步过去 —— 漏一次就会**提交旧代码**，
# 而 `git commit` 本身不会告诉你这件事（本轮真实踩过，手打 cp 6 次以上）。
#
# ⚠️ **单份代码平台（Windows 等）不适用**：`$WORKSPACE` == 仓库根时本检查自动跳过
#    （否则 `diff A A` 恒为空 → 永远「已同步」，那是**假绿**，比不检查更危险）。
#    「两份代码 + 手动同步」这套做法已于 2026-10-14 废弃，改用 worktree（见
#    docs/multi-session-collaboration.md §2.6 / §2.7）。
#
# ## 配置
#
# 读 `.git/collab-config`（**本机文件，不入库**），内容一行：
#
#     WORKSPACE=<工作区根目录>
#
# 用 sed 提取而非 `source` —— 避免执行文件里的任意代码。
# **没这个文件就跳过**（别的机器/克隆里没有，不该因此阻塞提交）。
#
# ## 在会话 worktree 里会自动跳过（这是**有意的**）
#
# 会话 worktree（`tools/session.sh new` 建的）里，`$ROOT/.git` 是个**文件**
# （内容形如 `gitdir: <主仓库>/.git/worktrees/<名字>`），
# 所以 `$ROOT/.git/collab-config` 不存在 → 本检查自然跳过。
#
# **这是正确的**：worktree 本身就是 git 工作树，
# 不存在「工作区 ↔ 仓库两套路径」的问题，无需同步检查。
#
# ============================================================
CFG="$ROOT/.git/collab-config"
WORKSPACE=""
if [ -f "$CFG" ]; then
    WORKSPACE=$(sed -n 's/^WORKSPACE=//p' "$CFG" | head -1)
fi

# 探测可用的 Python 解释器。
#
# ⚠️ 不能只 `command -v python3`：Windows 上 `python3` 可能是**应用商店占位程序** ——
#    命令「存在」，但一跑就非零退出且零输出。那样本钩子会把「解释器坏了」误报成
#    「工作区未同步」，于是**拦下每一次提交，理由还是错的**（最难查的一类故障）。
#    所以必须**真跑一次**验活，并按 `python3` → `python` 顺序回退。
PY=""
for _cand in python3 python; do
    if command -v "$_cand" >/dev/null 2>&1 && "$_cand" -c 'import sys' >/dev/null 2>&1; then
        PY="$_cand"
        break
    fi
done

# 单份代码平台：工作区就是仓库根 → 同步检查不适用，跳过（不是失败）。
if [ -n "$WORKSPACE" ] && [ "$(cd "$WORKSPACE" 2>/dev/null && pwd -P)" = "$(cd "$ROOT" && pwd -P)" ]; then
    WORKSPACE=""
fi

if [ -n "$WORKSPACE" ] && [ -d "$WORKSPACE" ]; then
    if [ -z "$PY" ]; then
        echo "[pre-commit] ⚠️ 跳过工作区同步检查：找不到可用的 python（python3 可能是应用商店占位程序）" >&2
    elif ! "$PY" "$ROOT/tools/collab_status.py" --check-sync --workspace "$WORKSPACE"; then
        echo ""
        echo "=========================================="
        echo " 提交被拦截：工作区改动尚未同步到仓库"
        echo "=========================================="
        echo " 先同步再提交，否则仓库里是旧代码。"
        echo " 同步：cp -r \"$WORKSPACE/app/src/.\" \"$ROOT/app/src/\""
        echo " 更推荐：改用 worktree 隔离（docs/multi-session-collaboration.md §2.6）"
        echo " 确实无需同步（如只改本机文件）：git commit --no-verify"
        echo ""
        exit 1
    fi
fi

echo "[pre-commit] 正在审计暂存区内容..."
if ! sh "$AUDIT" --staged; then
    echo ""
    echo "=========================================="
    echo " 提交被拦截：暂存区里可能有敏感信息"
    echo "=========================================="
    echo " 请检查并移除上述文件后重试。"
    echo " 确实要绕过（不推荐）：git commit --no-verify"
    echo ""
    exit 1
fi

echo "[pre-commit] 审计通过 ✓"
exit 0
