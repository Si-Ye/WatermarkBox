# ===== 构建产物 =====
/build
/app/build
/captures
.gradle/
.kotlin/

# ===== 签名与密钥（绝对不能提交）=====
keystore.properties
keystore/
*.jks
*.keystore
*.p12
# 用于上传到 CI Secret 的密钥 base64 副本 —— 同样是密钥，绝不可入库
keystore.b64
*.jks.b64
*.b64

# ===== 本地环境配置 =====
local.properties
.env

# ===== IDE =====
*.iml
.idea/
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.vscode/

# ===== 原生构建 =====
.externalNativeBuild
.cxx
*.so.debug

# ===== 系统文件 =====
.DS_Store
Thumbs.db
*.log

# ===== 本地工具与平台文件（与项目无关，不应开源）=====
/tools/aapt2
/.operit/
/.backup/

# ===== 安装包（走 GitHub Releases 分发）=====
*.apk
*.aab
*.ap_
!app/build/outputs/apk/**/output-metadata.json

# ===== 交付产物归档（含密钥备份与 mapping，绝不提交）=====
# dist/ 全目录排除：内含 APK / 源码包 / 密钥包 / 混淆映射表
/dist/

# ===== Python 字节码缓存 =====
# tools/ 下有几个辅助脚本，运行后会生成 __pycache__，
# 那是本机产物，不含任何源码信息，不应入库。
__pycache__/
*.py[cod]

# ===== tools/ 下的临时脚本 =====
# 排查问题时常在 tools/ 里写一次性脚本（.xxx.sh / .xxx.py），
# 用点号开头表示「临时」。这些不该入库，也不该阻塞提交。
# 加这条规则是为了防止「调试完忘了删，顺手 git add -A 提交上去」。
#
# 注意：要保留的正式脚本（如 pre_push_audit.sh）不带点号前缀，不受影响。
tools/.*
tools/*.tmp
tools/*.bak
